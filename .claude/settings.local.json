{
  "outputStyle": "korean-concise",
  "hooks": {
    "Stop": [
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$text = '작업이 완료되었습니다'; Add-Type -AssemblyName System.Speech; $s = New-Object System.Speech.Synthesis.SpeechSynthesizer; $s.Speak($text)\""
          }
        ]
      },
      {
        "matcher": "zsh",
        "hooks": [
          {
            "type": "command",
            "command": "say \"작업이 완료되었습니다.\""
          }
        ]
      }
    ]
  }
}
